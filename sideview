#!/usr/bin/env python3
"""sideview — vim-style file navigator + git dashboard for a side terminal pane.

Usage:
    sideview [DIR]

Environment:
    SIDEVIEW_ICONS=emoji|nerd|off   icon style (default emoji)
    EDITOR                          editor for Enter/e (default vim)

Keys:
    j/k or arrows   move           gg / G       top / bottom
    h               collapse / up  l or Enter   expand dir
    Enter or e      edit file in $EDITOR (vim)
    Ctrl-d/Ctrl-u   half page down/up
    /               fuzzy find file (Enter open, Esc cancel)
    d               toggle diff view in preview
    p               toggle preview pane
    J/K             scroll preview
    .               toggle hidden files
    r               refresh
    q               quit
"""
